{
  "_readme": [
    "示例模板：校园食堂需求预测（对应需求文档里的 SMART FOOD FORECAST 草图）。",
    "用法：copy templates/food-demand.json template.json  （或用 --template 参数指定）",
    "换模板后页面标题、下拉框、输出文案全部自动变化，代码零改动。"
  ],

  "id": "food-demand",
  "app": {
    "brand": "CAMPUS",
    "title": "SMART FOOD FORECAST",
    "subtitle": "AI-powered Campus Food Forecast",
    "footer": "FastAPI · 模板驱动 · 外接模型 API 见 TEMPLATE.md"
  },

  "dataset": {
    "path": "data/menu_demand.csv",
    "date_column": "date",
    "target": "portions",
    "unit": "portions",
    "target_label": "需求份数"
  },

  "model": {
    "plugin": "group-baseline",
    "options": {
      "effect_min_rows": 5,
      "baseline_filter": {
        "weekday": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
      },
      "baseline_label": "a typical weekday",
      "fallback_plugin": "group-baseline"
    }
  },

  "fields": [
    {
      "name": "menu",
      "label": "Menu",
      "type": "select",
      "source": "dataset",
      "column": "menu",
      "required": true,
      "default": "Chicken Rice"
    },
    {
      "name": "day",
      "label": "Day",
      "type": "select",
      "source": "dataset",
      "column": "weekday",
      "required": true,
      "default": "Friday",
      "help": "预测哪一天"
    },
    {
      "name": "weather",
      "label": "Weather",
      "type": "select",
      "source": "dataset",
      "column": "weather",
      "required": true,
      "default": "Rain"
    },
    {
      "name": "event",
      "label": "Event",
      "type": "select",
      "source": "dataset",
      "column": "event",
      "required": true,
      "default": "None",
      "help": "无特殊事件时选 None"
    }
  ],

  "output": {
    "locale": "en",
    "headline": "Tomorrow's predicted demand",
    "subheadline": "基于历史条件的需求预测",
    "unit": "portions",
    "decimals": 0,
    "delta_label": "vs. normal",
    "explanation_title": "AI Explanation",
    "submit_label": "Predict Demand"
  }
}
