# SDC Hackathon - local configuration
#
# Every value below has a working default in backend/database.py, so the project
# runs with this file left untouched. Copy to .env and edit as needed.

# Leave commented to use the absolute default: <project>/data/sales.db
# DATABASE_URL=sqlite:///data/sales.db

# Server binding used by backend.server
HOST=127.0.0.1
PORT=8000

# Set to 1 to skip seeding data/sales.csv into SQLite on startup
SKIP_DB_SEED=0

# Optional: any OpenAI-compatible gateway turns on the LLM business narrative.
# Leave the key empty to stay on the deterministic rule engine (no network).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=25

# Set to 1 to train only the fast Ridge candidate (used by the test suite)
FORECAST_FAST=0

# ---------------------------------------------------------------------------
# Hand the prediction to your own model service (route 1 and route 2 both use these)
# ---------------------------------------------------------------------------
# MODEL_BACKEND=http
# MODEL_API_URL=http://127.0.0.1:9000/predict
# MODEL_API_KEY=
# MODEL_API_TIMEOUT=15
# Fall back to the local plugin when the model API dies: local (default) | off
# MODEL_API_FALLBACK=local

# ---------------------------------------------------------------------------
# Used by the route 1 reference service: examples/llm_explainer_service.py
# It calls an OpenAI-compatible gateway to write the explanation sentence.
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT=20
EXPLAINER_HOST=127.0.0.1
EXPLAINER_PORT=9000
# LLM_DISABLE=1        # offline rehearsal: never call the network
